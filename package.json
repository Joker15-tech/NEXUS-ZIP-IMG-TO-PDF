{
    "name": "zipped-imgs-to-pdf",
    "version": "2.0.0",
    "description": "NEXUS QUANTUM — Convert ZIP archives or image sets into a single PDF. 100% client-side, zero uploads, zero telemetry.",
    "keywords": [
        "zip",
        "pdf",
        "image",
        "converter",
        "client-side",
        "offline",
        "jszip",
        "jspdf",
        "nexus-quantum",
        "batch-conversion",
        "natural-sort"
    ],
    "author": {
        "name": "NEXUS_QUANTUM",
        "email": "drxenon487@gmail.com",
        "url": "https://x.com/NEXUS_QUANTUM"
    },
    "contributors": [
        {
            "name": "Dr NEXUS",
            "url": "https://github.com/NEXUS_QUANTUM"
        }
    ],
    "license": "MIT",
    "type": "module",

    "homepage": "https://github.com/Joker15-tech/NEXUS-ZIP-IMG-TO-PDF#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Joker15-tech/NEXUS-ZIP-IMG-TO-PDF.git"
    },
    "bugs": {
        "url": "https://github.com/9Joker15-tech/Joker15-tech/NEXUS-ZIP-IMG-TO-PDF/issues",
        "email": "drxenon487@gmail.com"
    },

    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },

    "packageManager": "npm@10.8.0",

    "files": [
        "shared/",
        "web/",
        "python/",
        "README.md",
        "LICENSE",
        "package.json"
    ],

    "sideEffects": false,

    "exports": {
        "./shared/constants": {
            "import": "./shared/constants.js",
            "require": "./shared/constants.js",
            "default": "./shared/constants.js"
        },
        "./shared/sorting-logic": {
            "import": "./shared/sorting-logic.js",
            "require": "./shared/sorting-logic.js",
            "default": "./shared/sorting-logic.js"
        },
        "./web/app": "./web/app.js",
        "./package.json": "./package.json"
    },

    "main": "shared/sorting-logic.js",
    "module": "shared/sorting-logic.js",
    "browser": "web/app.js",

    "scripts": {
        "build:netlify": "bash scripts/build-netlify.sh",
        "// ─── TESTING ───────────────────────────────────": "",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=./coverage/junit.xml",

        "// ─── PYTHON ────────────────────────────────────": "",
        "py:test": "pytest",
        "py:test:unit": "pytest -m unit",
        "py:test:integration": "pytest -m integration",
        "py:test:coverage": "pytest --cov=shared --cov=python --cov-report=html --cov-report=term-missing",
        "py:install": "pip install -r requirements-dev.txt",
        "py:install:runtime": "pip install -r python/requirements.txt",

        "// ─── LINTING / FORMAT ──────────────────────────": "",
        "lint": "eslint . --ext .js,.mjs",
        "lint:fix": "eslint . --ext .js,.mjs --fix",
        "format": "prettier --write \"**/*.{js,mjs,json,css,html,md}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,json,css,html,md}\"",

        "// ─── DEV SERVER ────────────────────────────────": "",
        "serve": "npx --yes serve web -l 3000",
        "serve:python": "python -m http.server 8000 --directory web",
        "dev": "npm run serve",

        "// ─── BUILD / PREPARE ──────────────────────────": "",
        "prepare": "node -e \"console.log('NEXUS QUANTUM v2.0.0 ready')\"",
        "prepublishOnly": "npm run test && npm run lint"
    },

    "devDependencies": {
        "@vitest/coverage-v8": "^1.6.0",
        "@vitest/ui": "^1.6.0",
        "eslint": "^8.57.0",
        "jsdom": "^24.1.0",
        "prettier": "^3.3.3",
        "vitest": "^1.6.0"
    },

    "dependencies": {
        "jspdf": "^2.5.1",
        "jszip": "^3.10.1"
    },

    "peerDependencies": {
        "jspdf": "^2.5.1",
        "jszip": "^3.10.1"
    },

    "peerDependenciesMeta": {
        "jspdf": { "optional": true },
        "jszip": { "optional": true }
    },

    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },

    "config": {
        "app_version": "2.0.0-nexus",
        "app_codename": "QUANTUM"
    }
}
